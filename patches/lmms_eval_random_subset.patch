+def build_random_subset_doc_ids(task_sizes, task_groups, fraction, min_samples, seed):
+    """Return deterministic, exact-size, group-stratified document IDs."""
+    if not 0 < fraction <= 1:
+        raise ValueError(f"random subset fraction must be in (0, 1], got {fraction}")
+    if min_samples < 0:
+        raise ValueError(f"random subset minimum must be non-negative, got {min_samples}")
+
+    grouped_tasks = collections.defaultdict(list)
+    for task_name in sorted(task_sizes):
+        grouped_tasks[task_groups.get(task_name) or task_name].append(task_name)
+
+    selected = {}
+    for group_name, task_names in grouped_tasks.items():
+        total_size = sum(task_sizes[name] for name in task_names)
+        target = min(total_size, max(math.ceil(total_size * fraction), min_samples))
+        allocations = {}
+        remainders = []
+        allocated = 0
+        for task_name in task_names:
+            exact = task_sizes[task_name] * target / total_size if total_size else 0
+            count = min(task_sizes[task_name], math.floor(exact))
+            allocations[task_name] = count
+            allocated += count
+            remainders.append((exact - count, task_name))
+        for _, task_name in sorted(remainders, key=lambda item: (-item[0], item[1])):
+            if allocated >= target:
+                break
+            if allocations[task_name] < task_sizes[task_name]:
+                allocations[task_name] += 1
+                allocated += 1
+
+        for task_name in task_names:
+            task_size = task_sizes[task_name]
+            count = allocations[task_name]
+            if task_name == "mme" and 0 < count < task_size:
+                count = min(task_size, count + count % 2)
+                pair_count = task_size // 2
+                selected_pairs = count // 2
+                population = list(range(pair_count))
+                seed_material = f"{seed}:{group_name}:{task_name}:pairs"
+                task_seed = int.from_bytes(hashlib.sha256(seed_material.encode()).digest()[:8], "big")
+                pair_ids = random.Random(task_seed).sample(population, selected_pairs)
+                selected[task_name] = sorted(doc_id for pair_id in pair_ids for doc_id in (2 * pair_id, 2 * pair_id + 1))
+                continue
+            seed_material = f"{seed}:{group_name}:{task_name}"
+            task_seed = int.from_bytes(hashlib.sha256(seed_material.encode()).digest()[:8], "big")
+            selected[task_name] = sorted(random.Random(task_seed).sample(range(task_size), count))
+    return selected
+
